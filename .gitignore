# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
release/
desktop/dist/
*.log

# Environment files (never commit real credentials)
.env
.env.*
env.env
*.env
!.env.example

# Browser/curl cookie dumps (may contain live session cookies)
cookies.txt
cookies.txt.*
*.cookie*

# SQLite (removido - agora usamos PostgreSQL)
data/**/*.sqlite
data/**/*.sqlite-shm
data/**/*.sqlite-wal
data/**/*.sqlite-journal

# PostgreSQL (local dev only - Railway uses DATABASE_URL)
pgdata/

# Distributable binaries (published via GitHub Releases, not git)
public/downloads/*
!public/downloads/README.txt

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
.cache/
*.pre-audit-backup
