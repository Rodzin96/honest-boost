# Copy to .env and set real values. NEVER commit the filled .env file.

# --- Server ---
PORT=3000
NODE_ENV=development
# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Public base URL, used to build absolute links (password reset, checkout return).
PUBLIC_BASE_URL=http://localhost:3000

# --- Admin bootstrap (creates the admin account on first boot) ---
ADMIN_USER=admin@example.com
ADMIN_PASS=change-this-password

# --- Payments (Cakto) ---
# Checkout link per product. Falls back to CAKTO_CHECKOUT_URL when unset.
CAKTO_CHECKOUT_URL=
CAKTO_CHECKOUT_URL_BASIC=
CAKTO_CHECKOUT_URL_STARTER=
CAKTO_CHECKOUT_URL_PRO=
# Shared secret used to authenticate incoming payment webhooks.
PAYMENT_WEBHOOK_SECRET=

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- SMTP for password reset emails (optional in dev, required in production) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Honest Boost <noreply@yourdomain.com>

# --- Backups ---
BACKUP_DIR=
# Keep at most N backups (older ones are pruned). Default: 10
BACKUP_KEEP=10
# Set to 1 to skip the startup backup entirely.
SKIP_STARTUP_BACKUP=0
