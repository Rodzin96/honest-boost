# Environment variables for Honest Boost
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=production

# Session
SESSION_SECRET=your-super-secret-key-here

# Public URL (used for links in emails, etc.)
PUBLIC_BASE_URL=https://your-app.up.railway.app

# Desktop app API URL (used by Electron to validate generated keys)
HONEST_BOOST_API_BASE_URL=http://localhost:3000

# Database (PostgreSQL on Railway - automatically set)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Payment (Stripe)
# Crie uma chave secreta em https://dashboard.stripe.com/apikeys
STRIPE_SECRET=sk_live_...
# Endpoint secret do webhook (Stripe Dashboard -> Webhooks):
PAYMENT_WEBHOOK_SECRET=whsec_...

# Admin
ADMIN_USER=admin@yourdomain.com
ADMIN_PASS=your-strong-password

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Honest Boost <noreply@yourdomain.com>"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=https://your-app.up.railway.app/auth/google/callback
