# Environment variables for Honest Boost
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=production

# Session
SESSION_SECRET=your-super-secret-key-here

# Public URL (used for links in emails, etc.)
PUBLIC_BASE_URL=https://your-app.up.railway.app

# Database (PostgreSQL on Railway - automatically set)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Payment (Cakto)
CAKTO_CHECKOUT_URL=https://pay.cakto.com.br/checkout/...
CAKTO_CHECKOUT_URL_PRO=https://pay.cakto.com.br/checkout/...
CAKTO_CHECKOUT_URL_STARTER=https://pay.cakto.com.br/checkout/...
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# Admin
ADMIN_USER=admin@yourdomain.com
ADMIN_PASS=your-strong-password

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Honest Boost <noreply@yourdomain.com>"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=https://your-app.up.railway.app/auth/google/callback
