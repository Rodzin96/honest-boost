<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Honest Boost — Otimização de Windows Premium | Mais FPS em Um Clique</title>
    <meta name="description" content="Honestamente otimizado. Aumente FPS, reduza input lag e domine jogos competitivos com Honest Boost — testado e validado por 10.000+ jogadores.">
    <meta name="theme-color" content="#030512">
    <meta name="color-scheme" content="dark">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Honest Boost">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:title" content="Honest Boost — Otimização Premium | Mais FPS em Um Clique">
    <meta property="og:description" content="Aumenta FPS, reduz input lag, estabiliza frames. Seguro, reversível, 100% transparente.">
    <link rel="canonical" href="https://honestboost.com.br/">
    <link rel="manifest" href="manifest.json">
    <link rel="icon" type="image/svg+xml" href="logo.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
    <link rel="stylesheet" href="styles.css">
    <script>
        (function () {
            try {
                var t = localStorage.getItem('hb-theme');
                if (!t) t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }
        })();
    </script>
</head>
<body>
    <!-- Header -->
    <header class="site-header">
        <div class="header-inner">
            <a href="/" class="brand">
                <span class="brand-icon"><span class="material-symbols-rounded">rocket_launch</span></span>
                Honest<span>Boost</span>
            </a>
            <nav class="nav-links">
                <a href="#features">Funcionalidades</a>
                <a href="#results">Resultados</a>
                <a href="#testimonials">Depoimentos</a>
                <a href="#comparison">Comparativo</a>
                <a href="#faq">FAQ</a>
            </nav>
            <div class="header-actions" id="nav-actions">
                <a href="/about-honest.html" class="btn-secondary">Saiba Mais</a>
                <a href="/download-honest.html" class="btn-primary">Download</a>
                <a href="/login.html" class="btn-secondary" id="nav-login" style="display:none;">Entrar</a>
                <div class="nav-user" id="nav-user" style="display:none;">
                    <a href="/dashboard" style="display:flex;align-items:center;gap:8px;">
                        <div class="user-avatar" id="nav-avatar">U</div>
                        <span id="nav-username">Dashboard</span>
                    </a>
                </div>
            </div>
            <button class="nav-toggle" id="nav-toggle" aria-label="Menu">
                <span class="material-symbols-rounded">menu</span>
            </button>
        </div>
    </header>

    <main>
        <!-- Hero -->
        <section class="hero">
            <div class="hero-inner">
                <div class="hero-content">
                    <div class="badge">
                        <span class="badge-dot"></span>
                        Versão 2.0 Disponível
                    </div>
                    <h1>Honestamente <span>Otimizado</span></h1>
                    <p>Aumente o FPS, reduza input lag e domine jogos competitivos sem complicações. Seguro, transparente e testado por <strong>10.000+</strong> jogadores.</p>
                    <div class="hero-cta">
                        <a href="/download-honest.html" class="btn-primary">Baixar Agora</a>
                        <a href="#features" class="btn-secondary">Como Funciona →</a>
                    </div>
                    <div class="hero-stats">
                        <div class="hero-stat">
                            <span class="stat-number" id="stat-optimizations">10K+</span>
                            <span class="stat-label">Otimizações</span>
                        </div>
                        <div class="hero-stat">
                            <span class="stat-number">+45%</span>
                            <span class="stat-label">FPS Médio</span>
                        </div>
                        <div class="hero-stat">
                            <span class="stat-number">-60%</span>
                            <span class="stat-label">Input Lag</span>
                        </div>
                    </div>
                </div>
                <div class="hero-visual">
                    <div class="hero-mockup">
                        <div class="mockup-screen">
                            <div class="mockup-header">
                                <span class="material-symbols-rounded">speed</span>
                                <span>Honest Boost Desktop</span>
                            </div>
                            <div class="mockup-stats">
                                <div class="mockup-stat">
                                    <span class="material-symbols-rounded">auto_fix_high</span>
                                    <span>15 Otimizações</span>
                                </div>
                                <div class="mockup-stat">
                                    <span class="material-symbols-rounded">check_circle</span>
                                    <span>Aplicadas com sucesso</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features -->
        <section id="features" class="section">
            <div class="container">
                <div class="section-header">
                    <h2>Funcionalidades</h2>
                    <p>Tudo que você precisa para máxima performance</p>
                </div>
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon"><span class="material-symbols-rounded">speed</span></div>
                        <h3>Boost de FPS</h3>
                        <p>Otimizações de CPU, RAM e GPU para maximizar quadros por segundo.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon"><span class="material-symbols-rounded">mouse</span></div>
                        <h3>Mouse Otimizado</h3>
                        <p>Desativa aceleração, configura polling rate e remove input lag.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon"><span class="material-symbols-rounded">wifi</span></div>
                        <h3>Rede Otimizada</h3>
                        <p>Ajustes de TCP, DNS e QoS para menor ping e latência.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon"><span class="material-symbols-rounded">desktop_windows</span></div>
                        <h3>Monitor</h3>
                        <p>Detecta e aplica automaticamente o refresh rate máximo.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon"><span class="material-symbols-rounded">security</span></div>
                        <h3>100% Seguro</h3>
                        <p>Otimizações reversíveis. Sem scripts arriscados, sem CMD.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon"><span class="material-symbols-rounded">sports_esports</span></div>
                        <h3>Modo Gaming</h3>
                        <p>Fecha processos em segundo plano e otimiza tudo com um clique.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Results -->
        <section id="results" class="section section-alt">
            <div class="container">
