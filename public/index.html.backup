                <div class="results-grid">
                    <div class="result-card">
                        <div class="result-game">CS2</div>
                        <div class="result-before">503 FPS</div>
                        <div class="result-arrow"><span class="material-symbols-rounded">arrow_downward</span></div>
                        <div class="result-after">622 FPS</div>
                        <div class="result-gain">+23,6%</div>
                    </div>
                    <div class="result-card">
                        <div class="result-game">Valorant</div>
                        <div class="result-before">364 FPS</div>
                        <div class="result-arrow"><span class="material-symbols-rounded">arrow_downward</span></div>
                        <div class="result-after">511 FPS</div>
                        <div class="result-gain">+40%</div>
                    </div>
                    <div class="result-card">
                        <div class="result-game">Fortnite</div>
                        <div class="result-before">405 FPS</div>
                        <div class="result-arrow"><span class="material-symbols-rounded">arrow_downward</span></div>
                        <div class="result-after">510 FPS</div>
                        <div class="result-gain">+26%</div>
                    </div>
                    <div class="result-card">
                        <div class="result-game">Roblox</div>
                        <div class="result-before">130 FPS</div>
                        <div class="result-arrow"><span class="material-symbols-rounded">arrow_downward</span></div>
                        <div class="result-after">206 FPS</div>
                        <div class="result-gain">+58%</div>
                    </div>
                </div>
